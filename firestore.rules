rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each person's todos, lists and settings live in users/{their id}.
    // Only they can read or change it.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Upcoming reminder times and the person's devices, for sending reminders
    // while Daydot is closed. The reminder bot (one fixed account) can read them,
    // and may only update which reminders it has sent and remove dead devices.
    match /reminders/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && request.auth.uid == "TqNOkmuTZacO22LHdLHonyFYmvz2";
      allow update: if request.auth != null && request.auth.uid == "TqNOkmuTZacO22LHdLHonyFYmvz2"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["sent", "subs"]);
    }
  }
}
